# MonEscrow — environment. Implements C8 in docs/01-INTERFACES.md.
#
# Copy to `.env.local` and fill in the secrets. `.env.example` is committed;
# `.env.local` never is. Anything without NEXT_PUBLIC_ must never be read from a
# client component.
#
# The app is designed to run from a clean clone with nothing but this file
# (D-4: clean-clone instructions, no hosted deployment). The AI parser falls back
# to a deterministic template with no credentials at all, so a judge with no API
# key still gets a working /new page.

# ---------------------------------------------------------------- client (public)

# Set by Alfa at integration (A-5), after the factory is deployed and verified.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Monad testnet, chain id 10143.
NEXT_PUBLIC_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Optional server-side override for the same RPC. The verify and chat routes read this
# first, then NEXT_PUBLIC_MONAD_TESTNET_RPC, then the public endpoint above — so a clean
# clone needs none of them set. Only fill this in if you have a private endpoint.
MONAD_RPC_URL=

# Who signs attestations. Public on purpose: the UI shows it so anyone reading a
# job can check that the signature on a milestone came from the expected key, and
# `Escrow.attestationDigest(...)` lets them reproduce the digest byte-for-byte.
# This is the address half of the A-1 keypair. The private half is below.
NEXT_PUBLIC_VERIFIER_ADDRESS=0x87B9AfEafA109e96c41504E0ce84e08c055D5eaf

# Empty means fall back to an injected wallet (MetaMask, Rabby, ...).
NEXT_PUBLIC_PARA_API_KEY=

# ---------------------------------------------------------------- Convex
# The off-chain store for the documents C3/C4/C5 commit to by hash: the criteria,
# the evidence, and the verifier's report. Only their keccak hashes go on-chain, so
# something has to actually hold the JSON — until now, nothing did.
#
# Note what Convex is NOT for: listing jobs. `EscrowFactory` keeps its own onchain
# index precisely so a frontend can enumerate escrows with plain eth_calls and no
# indexer. If job listing ever starts reading from Convex instead of the chain, the
# product has quietly acquired a backend it can't justify — and a judge who turns the
# database off should still see every escrow.

# The Convex deployment your browser talks to. Public.
#   e.g. https://acoustic-panther-123.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# The HTTP-actions origin of the same deployment. Public.
#   same subdomain, .site instead of .cloud
NEXT_PUBLIC_CONVEX_SITE_URL=

# This app's own public origin. Previously safe to omit because it falls back to
# VERCEL_URL — but Convex HTTP actions and any callback need a stable, non-preview
# origin, so set it explicitly now.
NEXT_PUBLIC_SITE_URL=https://monescrow.vercel.app

# ---------------------------------------------------------------- server only
# Never prefix any of these with NEXT_PUBLIC_ and never commit a filled-in copy.

# The verifier's signing key. Signs the C2 attestation payload; it never broadcasts
# a transaction, so it needs no gas and holds no funds.
#
# Worth understanding before you worry about it: an attacker holding this key can
# propose a passing milestone, and that is all. A pass does not move money — it opens
# the challenge window, and the client can object during it. That is the whole reason
# the verifier proposes rather than decides. Rotate it anyway if it leaks; a leaked key
# costs the client attention, not funds.
#
# That claim used to be false and is now enforced. Until D-7 the constructor accepted
# `challengeWindow == 0`, and at zero this key COULD move money — attest and release land
# in the same block with the client never consulted. `Escrow` now rejects any window
# outside 60 s … 30 days, so the paragraph above is true of every escrow it can create.
#
# ---- THIS ONE IS NOT OPTIONAL, and it is blank on purpose ----
#
# `POST /api/verify` returns 502 without it, which means the "Run check" step of the demo
# does nothing. No key is shipped here because a signing key committed to a public repo is
# a signing key forever, even a throwaway one on testnet.
#
# Generate your own in two commands. The address and the private half must match, or every
# attestation you produce is rejected on chain with `BadSignature` and the failure looks
# like a bug in the contract rather than a mismatched pair:
#
#     cast wallet new
#     # then put the private key below, and its address in NEXT_PUBLIC_VERIFIER_ADDRESS above,
#     # replacing the 0x87B9AfE… default, which is Alfa's key and is not yours to sign with.
VERIFIER_PRIVATE_KEY=

# Convex deployment credential. Server/CI only — it can push code and read data on the
# deployment, so it is strictly more dangerous than the URLs above.
#
# NEVER prefix this NEXT_PUBLIC_. Next.js inlines every NEXT_PUBLIC_ variable into the
# client bundle at build time, and a published deploy key cannot be un-published from
# builds that already shipped. Rotate it in the Convex dashboard if it ever leaks.
CONVEX_DEPLOY_KEY=

# Optional. Raises the GitHub API rate limit for the `github` check. Without it the
# check still works, just with the anonymous limit — and a 403 rate-limit is reported
# as 502 (retry), never as a failing milestone.
GITHUB_TOKEN=

# Optional. BYOK: a key sent in the `x-llm-key` header wins over this, and this wins
# over the deterministic template parser. All three paths must work.
ANTHROPIC_API_KEY=
