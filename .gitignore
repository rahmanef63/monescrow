# No trailing slash on purpose: the root `node_modules` here is a dangling *symlink* into
# a machine-local /tmp (left by the mermaid checker), and `node_modules/` matches only
# real directories — so git tried to index the symlink and `git add -A` died with
# "Function not implemented".
node_modules
contracts/lib/
contracts/out/
contracts/cache/
contracts/broadcast/
web/.next/
web/out/
web/next-env.d.ts
.env
.env.local
.env*.local
.DS_Store
*.log
.vercel

# Keys. `deploy/**` is otherwise a committed record of what was deployed, so this
# exclusion is deliberate and load-bearing — the verifier keystore lives here and is
# encrypted with an empty password, which is to say not encrypted at all.
deploy/keys/
*.keystore
keystore/

# Relay scratch. Request/response envelopes carry signed Safe payloads; there is no
# reason for them to outlive the run that produced them.
tools/relay/spool/

# The agent skills are committed on purpose — see the changelog. The MONSKILLS
# installer silently drops the `wallet` skill, so vendoring the tree is what
# guarantees the next clone can still propose a Safe transaction.

